<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/txt_label_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="名称"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 晨跑、加班回家"
            android:inputType="text"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="从哪"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 家、公司、西湖东门"
            android:inputType="text"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="到哪"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 公司、灵隐、地铁口"
            android:inputType="text"
            android:maxLength="40"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="名称和从哪到哪可以以后在历史里再改。没填的话列表会用走路/跑步/骑车/自动和地图查到的街道名。"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
